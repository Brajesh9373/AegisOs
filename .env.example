# AegisOS environment — copy to .env and fill in (never commit .env).
# Used by ./scripts/start-aegisos.sh for BOTH stacks (backend + frontend),
# so the two ECMS_SERVICE_TOKEN values below always match.

# ── DSH agent hierarchy (LLM route for HOE/engineer sessions) ──
# Your Anthropic-compatible key. With the local Claude Code Proxy running on
# the HOST, containers must use host.docker.internal (container localhost is
# the container itself, not your machine).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=http://host.docker.internal:3457/v1

# Backend URL the DSH memory tools call from inside the backend container
# (same network namespace, so container localhost is correct here).
AEGISOS_API_URL=http://127.0.0.1:8000

# ── BFF ↔ ECMS trust (must be identical on both stacks) ──
# Auto-generated into .env on first start if left empty.
ECMS_SERVICE_TOKEN=

# ── ECMS backend reachability from the BFF container ──
# Service DNS on the shared ecms network (see frontend/docker-compose.yml).
ECMS_BACKEND_URL=http://backend:8000

# ── Optional provider keys (BA flow, categorization) ──
COMMAND_CODE_API_KEY=
ECMS_OPENAI_API_KEY=
ECMS_CATEGORIZE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
