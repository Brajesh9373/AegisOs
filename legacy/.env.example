# FalkorDB
ECMS_FALKORDB_HOST=localhost
ECMS_FALKORDB_PORT=6379
ECMS_FALKORDB_DATABASE=ecms
ECMS_FALKORDB_PASSWORD=admin

# Redis
ECMS_REDIS_URL=redis://localhost:6380/0

# LLM
ECMS_OPENAI_API_KEY=
ECMS_OPENAI_BASE_URL=
ECMS_LLM_MODEL=gpt-4o-mini
ECMS_LLM_SMALL_MODEL=
ECMS_EMBEDDING_MODEL=text-embedding-3-small
ECMS_EMBEDDING_BASE_URL=
ECMS_EMBEDDING_DIM=1024
ECMS_GRAPHITI_LLM_CLIENT=openai
ECMS_GRAPHITI_EMBEDDER=openai
ECMS_GRAPHITI_RESPONSE_FORMAT=json_object
ECMS_GRAPHITI_TELEMETRY_ENABLED=false

# API
ECMS_API_HOST=0.0.0.0
ECMS_API_PORT=8000
ECMS_API_KEY=ecms-secret-key
ECMS_AUTH_ENABLED=false
ECMS_RATE_LIMIT_PER_MINUTE=60

# Providers
ECMS_GIT_DEFAULT_CLONE_PATH=./data/repos
ECMS_SEMANTIC_MODE=keyword
ECMS_SEMANTIC_MIN_CONFIDENCE=0.70
